# Variáveis públicas do frontend (prefixo VITE_*, embutidas no bundle — nunca um segredo aqui).
# Copie para .env.local (gitignored) e preencha com os valores reais do projeto Supabase.
# Ver docs/BACKEND_PLAN.md.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# UUID do aluno de demonstração — gerado ao rodar `node scripts/seed-demo-users.mjs` (ver o
# script para o passo a passo). Sem isso, `mocks/students.ts` usa um id mockado que não bate com
# nenhuma linha real no Supabase, e a Avaliação Física não salva.
VITE_DEMO_STUDENT_ID=
